# oh-my-claudecode
.omc/

# Environment
.env
.env.local
.env.*.local

# Claude Code
.claude/*
!.claude/settings.json

# Playwright MCP
.playwright-mcp/

# Python
__pycache__/

# Node.js
node_modules/

# macOS
.DS_Store

# Debug screenshots
*.png
# But keep demo screenshots (flat + per-demo subdirectories)
!doc-sites/static/img/demos/*.png
!doc-sites/static/img/demos/**/*.png
# ...and demo deck assets (logos, etc.) shipped under each deck's common/
!doc-sites/static/demos/**/*.png
# ...and shared skill AWS icon libraries (official set + product icons like AgentCore)
!plugins/**/icons/**/*.png
# ...and the aws-light-fcd PPTX skill's bundled deck assets (backgrounds + AWS logo)
!plugins/aws-content-plugin/skills/aws-light-fcd/assets/backgrounds/*.png
!plugins/aws-content-plugin/skills/aws-light-fcd/assets/logo/*.png

# Test fixtures with fake secrets (triggers GitHub Push Protection)
tests/fixtures/secret-samples.txt

# Docusaurus
doc-sites/node_modules/
doc-sites/build/
doc-sites/.docusaurus/

# co-agent personal panel settings (model/effort/enabled/timeout overrides)
.claude/co-agent.local.json

# co-agent consensus session artifacts (raw model outputs, validated findings — ephemeral)
.claude/co-agent-consensus/

# co-agent panel-readiness summary (written by /co-agent:setup — machine-local)
.claude/co-agent-panel.local.json

# pr-review lens×model matrix membership override (enabled/model per cell)
.claude/pr-review.local.json

# scratch working dir (presentation/demo authoring — not tracked)
work/

# runtime artifacts + stray input archives (never commit)
*.pid
/Agentcore-Bedrock-Icons.pptx
/Pretendard-*.zip
/*.skill

# skill eval workspaces — generated run artifacts, not tracked
plugins/*/skills/*-workspace/

# user-provided design-system reference (kept on disk, not tracked)
/colors.css
/spacing.css
/typography.css

# local AI tool caches
.serena/
.headroom/
