# oh-my-claudecode
.omc/

# Environment
.env
.env.local
.env.*.local

# Claude Code
.claude/*
!.claude/settings.json

# Playwright MCP
.playwright-mcp/

# Python
__pycache__/

# Node.js
node_modules/

# macOS
.DS_Store

# Debug screenshots
*.png
# But keep demo screenshots (flat + per-demo subdirectories)
!docs/static/img/demos/*.png
!docs/static/img/demos/**/*.png
# ...and demo deck assets (logos, etc.) shipped under each deck's common/
!docs/static/demos/**/*.png

# Test fixtures with fake secrets (triggers GitHub Push Protection)
tests/fixtures/secret-samples.txt

# Docusaurus
docs/node_modules/
docs/build/
docs/.docusaurus/

# co-agent personal panel settings (model/effort/enabled/timeout overrides)
.claude/co-agent.local.json

# co-agent consensus session artifacts (raw model outputs, validated findings — ephemeral)
.claude/co-agent-consensus/

# scratch working dir (presentation/demo authoring — not tracked)
work/
