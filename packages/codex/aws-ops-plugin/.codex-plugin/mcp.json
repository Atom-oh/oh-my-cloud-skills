{
  "mcpServers": {
    "awsdocs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "type": "stdio",
      "timeout": 60000,
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "awsapi": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "type": "stdio",
      "timeout": 120000,
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
