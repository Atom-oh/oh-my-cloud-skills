{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 0"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(?:Edit|Write)|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 3"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 4"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 5"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 6"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/.codex-plugin/hook.py\" 7"
          }
        ]
      }
    ]
  }
}
